# Docker
POSTGRES_CONTAINER=postgres-repo-health
POSTGRES_DB=repohealth
POSTGRES_USER=repohealth
POSTGRES_PASSWORD=repohealth-local
POSTGRES_PORT=5433

PGBOUNCER_CONTAINER=pgbouncer-repo-health
PGBOUNCER_PORT=5432

WEB_PORT=8002
REDIS_PORT=6372
REDIS_URL=redis://redis-repo-health:6372/0

CELERY_RESULT_BACKEND=redis://redis-repo-health:6372/1

# Django
SECRET_KEY=change-me-local-dev-key
DEBUG=True
STAGE=False
ALLOWED_HOSTS=localhost,127.0.0.1,web-repo-health
TRUSTED_ORIGINS=http://localhost:8002,http://127.0.0.1:8002
FIELD_ENCRYPTION_KEY=random-encryption-key
SCAN_STALE_TIMEOUT_MINUTES=60

# API
SOURCECRAFT_API_BASE_URL=https://api.sourcecraft.tech
SOURCECRAFT_API_FILE_BASE_URL=https://raw.sourcecraft.tech
SOURCECRAFT_API_APPSEC_BASE_URL=https://appsec.sourcecraft.tech
SOURCECRAFT_API_TOKEN=
SOURCECRAFT_GIT_BASE_URL=https://git@git.sourcecraft.dev

# Я ID (oauth.yandex.ru). Redirect URI должен совпадать с настройкой приложения.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=http://127.0.0.1:8002/auth/yandex/callback/